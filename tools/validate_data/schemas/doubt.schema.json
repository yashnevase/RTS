{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "record_version": {
      "type": "integer",
      "minimum": 1
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^source_"
      }
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low",
        "contested",
        "fictional",
        "inferred"
      ]
    },
    "status": {
      "enum": [
        "open",
        "resolved"
      ]
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "blocking"
      ]
    },
    "entity_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "resolution": {
      "type": [
        "string",
        "null"
      ]
    },
    "legacy_entries": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "confidence",
    "entity_ids",
    "id",
    "question",
    "record_version",
    "resolution",
    "severity",
    "source_ids",
    "status"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
