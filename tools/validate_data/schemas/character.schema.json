{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^character_[a-z0-9_]+$"
    },
    "record_version": {
      "type": "integer",
      "minimum": 1
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^source_"
      }
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low",
        "contested",
        "fictional",
        "inferred"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "researched",
        "reviewed",
        "approved",
        "fictional",
        "deprecated",
        "stub"
      ]
    },
    "identity": {
      "type": "object",
      "properties": {
        "primary_name": {
          "type": "string"
        },
        "name_variants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "birth_year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "death_year": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "primary_name",
        "name_variants",
        "birth_year",
        "death_year"
      ],
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "confidence",
    "id",
    "identity",
    "record_version",
    "source_ids",
    "status"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
