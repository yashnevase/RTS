{
  "type": "object",
  "properties": {
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low",
        "contested",
        "fictional",
        "inferred"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^region_[a-z0-9_]+$"
    },
    "macro_region_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "type": "string"
    },
    "name_variants": {
      "type": "array",
      "items": {}
    },
    "notes": {
      "type": "string"
    },
    "parent_region_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "record_version": {
      "type": "integer",
      "minimum": 1
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^source_"
      }
    },
    "status": {
      "enum": [
        "draft",
        "researched",
        "reviewed",
        "approved",
        "fictional",
        "deprecated",
        "stub"
      ]
    }
  },
  "required": [
    "confidence",
    "id",
    "macro_region_id",
    "name",
    "name_variants",
    "notes",
    "parent_region_id",
    "record_version",
    "source_ids",
    "status"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
