{
  "type": "object",
  "properties": {
    "author": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "caveat": {
      "type": "string"
    },
    "claim_scope": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^source_[a-z0-9_]+$"
    },
    "licence": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "notes": {
      "type": "string"
    },
    "publisher": {
      "type": "string"
    },
    "source_type": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "researched",
        "reviewed",
        "approved",
        "fictional",
        "deprecated",
        "stub"
      ]
    },
    "supports": {
      "type": "string"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "year": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "record_version": {
      "type": "integer",
      "minimum": 1
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^source_"
      }
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low",
        "contested",
        "fictional",
        "inferred"
      ]
    }
  },
  "required": [
    "confidence",
    "id",
    "record_version",
    "source_ids",
    "status",
    "title",
    "url"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
